# Copia questo file in .env e riempi i valori.
# .env non entra nel repository: lo esclude .gitignore.
#
# Questi due si prendono dal cruscotto Supabase, Project Settings -> API.
# La chiave "publishable" e' fatta per stare dentro una pagina web: da sola
# non apre niente, perche' chi vede cosa lo decidono le regole di riga del
# database. La chiave "service_role" invece NON va mai qui dentro.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
