# Intestazioni di sicurezza e di cache per Cloudflare Pages.

/*
  # Niente <iframe> altrui: nessuno incornicia il sito per fingersi noi.
  X-Frame-Options: DENY
  # Il browser non prova a indovinare il tipo di un file.
  X-Content-Type-Options: nosniff
  # Fuori dal sito non diciamo da quale pagina si arriva.
  Referrer-Policy: strict-origin-when-cross-origin
  # Non chiediamo niente di tutto questo: meglio dirlo.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Solo https, per un anno.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# I file con l'impronta nel nome (app-4f3a1b.js) non cambiano mai a parita'
# di nome: si possono tenere per sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html invece deve essere richiesto ogni volta, altrimenti dopo un
# aggiornamento la gente continua a vedere il sito vecchio.
/index.html
  Cache-Control: no-cache
